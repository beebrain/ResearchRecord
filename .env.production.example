# Research Record — Production (sci.uru.ac.th/Research)
#--------------------------------------------------------------------
# โฟลเดอร์เดียวกับ newScience บน win-kc:
#   C:\inetpub\ResearchRecord\
# คัดลอกไปที่ server:
#   copy .env.production.example C:\inetpub\ResearchRecord\.env
# แก้ค่า password / key ให้ตรง server จริง — ไฟล์ .env ไม่ commit
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://sci.uru.ac.th/recordresearch/'
app.indexPage = 'index.php'
app.appTimezone = 'Asia/Bangkok'
app.defaultLocale = 'th'

#--------------------------------------------------------------------
# DATABASE (MySQL — ฐาน rac บน win-kc / sci server)
#--------------------------------------------------------------------
# ถ้า MySQL อยู่เครื่องเดียวกับ IIS ใช้ localhost
# ถ้า remote ใช้ IP/host จริง (เช่น 202.29.52.124)

database.default.hostname = localhost
database.default.database = rac
database.default.username = rac
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.DBDebug = false

#--------------------------------------------------------------------
# ENCRYPTION (สร้างใหม่ — ห้าม copy จาก repo)
#--------------------------------------------------------------------
# php spark key:generate
# หรือ: php -r "echo bin2hex(random_bytes(16));"

encryption.key = hex:CHANGE_ME_32_BYTES

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGIN — ผ่าน newScience (ไม่ login Portal ตรงที่ RR)
#--------------------------------------------------------------------
# newScience เป็นตัวตรวจ URU Portal แล้วส่ง SSO token กลับมา /auth/sso-entry

newscience.baseUrl = "https://sci.uru.ac.th"

newscience_sso.enabled = true
newscience_sso.sharedSecret = "pisit_secret"

# ปิด OAuth ตรงที่ RR (ใช้ newScience แทน)
uruoauth.enabled = false

#--------------------------------------------------------------------
# API — newScience / ระบบภายนอกเรียก RR
#--------------------------------------------------------------------
# ค่า RESEARCH_API_KEY ต้องตรงกับ newScience .env

RESEARCH_API_KEY = CHANGE_ME
RESEARCH_SYNC_HMAC_SECRET = CHANGE_ME

# Curriculum detail API (token แยก)
CURRICULUM_API_TOKEN = CHANGE_ME

#--------------------------------------------------------------------
# OPTIONAL
#--------------------------------------------------------------------

# email.fromEmail = 'noreply@sci.uru.ac.th'
# email.fromName = 'ระบบจัดการผลงานวิจัย คณะวิทยาศาสตร์ฯ'
