# Copy to scripts/ftp_rr.env and fill secrets locally.
# Never commit scripts/ftp_rr.env.

FTP_HOST=202.29.52.124
FTP_PORT=21
FTP_USER=rac
# FTP_PASS=

# Remote project root verified on RR production.
FTP_REMOTE_ROOT=research_academic

# Local backups are written outside tracked source by default.
LOCAL_BACKUP_ROOT=deploy-backups/RR

# Keep newest N local backup sets. Remote backup pruning is intentionally manual.
KEEP_LOCAL_BACKUPS=10
